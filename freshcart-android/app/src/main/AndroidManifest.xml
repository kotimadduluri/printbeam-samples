<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The SDK's subnet discovery reads the WiFi network via ConnectivityManager, which
         needs this. Declared here because printbeam 0.1.0-alpha01's manifest doesn't ship
         it; from alpha02 the SDK declares it itself and this line becomes redundant. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".FreshCartApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.FreshCart">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
